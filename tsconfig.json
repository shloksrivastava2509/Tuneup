{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["installer"],
  "exclude": ["installer/**/*.test.ts"]
}
