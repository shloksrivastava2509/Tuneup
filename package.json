{
  "name": "tuneup",
  "version": "0.1.0",
  "description": "Setup kit for Claude Code: lean, right-sized config and a token dashboard mod",
  "license": "MIT",
  "type": "module",
  "bin": { "tuneup": "dist/installer/bin.js" },
  "files": ["dist", "catalog", "profiles", "templates", "plugins", ".claude-plugin"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p plugins/tuneup-dashboard",
    "test": "node --import tsx --test \"installer/**/*.test.ts\"",
    "test:mod": "claude plugin test ./plugins/tuneup-dashboard",
    "validate:mod": "claude plugin validate ./plugins/tuneup-dashboard",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
